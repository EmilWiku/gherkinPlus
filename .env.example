# Copy to `.env` and fill in. Never commit `.env`.

# Pocket Option session (full Socket.IO auth string or session id)
POCKET_OPTION_SSID=
# Or path to a file containing the SSID (overridden if POCKET_OPTION_SSID is set)
# POCKET_OPTION_SSID_FILE=./data/ssid.txt

# Telegram (optional for dry runs; required if bot sends alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Forum topic / thread ID for Telegram groups with topics (main_v3 / main_v4)
# TELEGRAM_TOPIC_ID=2

# Optional proxy for PocketOption traffic (SOCKS5/HTTP URL)
# POCKET_OPTION_PROXY_URL=socks5://127.0.0.1:1080

# SQLite path for trade metrics (default: artifacts/trading_metrics.db)
# TRADE_DB_PATH=artifacts/trading_metrics.db

# Deploy scripts / Ansible SSH (use keys in production instead of password auth)
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=

# Pocket Option web login (get_ssid_automated.py only)
# POCKET_OPTION_EMAIL=
# POCKET_OPTION_PASSWORD=
